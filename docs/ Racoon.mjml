```mjml
<mjml>
  <mj-head>
    <mj-attributes>
      <mj-text font-family="Arial, sans-serif" />
      <mj-button font-family="Arial, sans-serif" />
    </mj-attributes>
  </mj-head>
  <mj-body>
    <!-- Top purple header with logo and main title -->
    <mj-section background-color="#635dda" padding="40px 24px 40px 24px" >
      <mj-column>
        <mj-image src="https://placehold.co/40x40/635dda/FFFFFF?text=Logo" alt="racoon.ai logo" width="40px" padding="0px" />
      </mj-column>
      <mj-column>
        <mj-text color="#FFFFFF" font-size="24px" line-height="32px" font-weight="500" padding="0 0 0 8px" align="left" >
          We’re updating our Terms<br />of Service and Privacy<br />Policy
        </mj-text>
      </mj-column>
      <mj-column width="60px">
        <mj-image src="https://placehold.co/60x60/7b78ea/FFFFFF?text=" width="60px" alt="" padding="0" />
      </mj-column>
      <mj-column width="80px">
        <mj-image src="https://placehold.co/80x80/837aea/FFFFFF?text=" width="80px" alt="" padding="0" />
      </mj-column>
    </mj-section>

    <!-- White background - main text content -->
    <mj-section background-color="#FFFFFF" padding="32px 48px 32px 48px" >
      <mj-column>
        <mj-text font-size="14px" font-weight="700" color="#303030" padding="0 0 8px 0" align="left">More Transparency</mj-text>
        <mj-text font-size="14px" color="#505050" line-height="20px" padding="0 0 16px 0" align="left">
          As the racoon.ai community continues to grow, We’re updating our Terms of Service and Privacy Policy. These changes will go into effect immideately.
        </mj-text>
        <mj-text font-size="14px" color="#505050" line-height="20px" padding="0 0 19px 0" align="left">
          We encourage you to read them in their entirety, but here are the highlights of what’s changing:
        </mj-text>

        <mj-text font-size="14px" font-weight="700" color="#303030" padding="0 0 6px 0" align="left">Terms of Service</mj-text>
        <mj-text font-size="14px" color="#505050" line-height="20px" padding="0 0 16px 0" align="left">
          The Terms of Service has been updated to better describe our payments process and how we offer promotions, offers, and credits.
        </mj-text>

        <mj-text font-size="14px" font-weight="700" color="#303030" padding="0 0 6px 0" align="left">Privacy Policy</mj-text>
        <mj-text font-size="14px" color="#505050" line-height="20px" padding="0 0 30px 0" align="left">
          The updated Privacy Policy is easier to read and better describes the types of data we collect, how we collect it, how we use it, and with whom we share it. Ut describes the role that data plays in helping us maintain trust, safety and reliability on the Platform.
        </mj-text>

        <mj-divider border-color="#E0E0E0" padding="0" />

        <mj-text font-size="12px" color="#505050" line-height="18px" padding="16px 0 4px 0" align="left">
          By continuing to use our Platform or after January 1 you acknowledge and agree to our updated Terms of Service and Privacy Policy.
        </mj-text>
        <mj-text font-size="12px" color="#505050" line-height="18px" padding="0 0 4px 0" align="left">
          Thank you for being a member of racoon.ai community.
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Light purple background with crypto rewards program -->
    <mj-section background-color="#E9E8FD" padding="32px 48px 32px 48px">
      <mj-column>
        <mj-text font-size="16px" font-weight="700" color="#453AA6" padding="0 0 8px 0" align="left">
          Join Crypto Rewards Program Today
        </mj-text>
        <mj-text font-size="14px" color="#505050" line-height="20px" padding="0 0 24px 0" align="left">
          Racoon.ai makes earning crypto rewards easy. Experience flexible access to your crypto whenever you need + earn higher daily crypto rewards for being a VIP members.
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Bonus rates row -->
    <mj-section background-color="#E9E8FD" padding="0 48px 0 48px">
      <mj-column width="48px">
        <mj-image src="https://placehold.co/24x24/8A8EF7/FFFFFF?text=🪙" alt="Bonus icon" width="24px" padding="0" />
      </mj-column>
      <mj-column>
        <mj-text font-size="14px" font-weight="700" color="#453AA6" padding="0 0 0 0" align="left">Up to 10% bonus rates</mj-text>
        <mj-text font-size="12px" color="#505050" padding="4px 0 16px 0" align="left">Paid daily in crypto in Racoon Wallet</mj-text>
      </mj-column>
    </mj-section>

    <!-- Easy and Flexible row -->
    <mj-section background-color="#E9E8FD" padding="0 48px 0 48px">
      <mj-column width="48px">
        <mj-image src="https://placehold.co/24x24/8A8EF7/FFFFFF?text=🔲" alt="Easy icon" width="24px" padding="0" />
      </mj-column>
      <mj-column>
        <mj-text font-size="14px" font-weight="700" color="#453AA6" padding="0 0 0 0" align="left">Easy and Flexible</mj-text>
        <mj-text font-size="12px" color="#505050" padding="4px 0 16px 0" align="left">No lock-in period and easy app management</mj-text>
      </mj-column>
    </mj-section>

    <!-- VIP Levels & benefits row -->
    <mj-section background-color="#E9E8FD" padding="0 48px 24px 48px">
      <mj-column width="48px">
        <mj-image src="https://placehold.co/24x24/8A8EF7/FFFFFF?text=⭐" alt="VIP icon" width="24px" padding="0" />
      </mj-column>
      <mj-column>
        <mj-text font-size="14px" font-weight="700" color="#453AA6" padding="0 0 0 0" align="left">VIP Levels &amp; benefits</mj-text>
        <mj-text font-size="12px" color="#505050" padding="4px 0 0 0" align="left">Get higher bonus rates by locking racoon Token</mj-text>
      </mj-column>
    </mj-section>

    <!-- Button -->
    <mj-section background-color="#E9E8FD" padding="0 48px 40px 48px">
      <mj-column>
        <mj-button background-color="#635dda" color="#ffffff" font-weight="600" border-radius="4px" href="#" padding="12px 0" inner-padding="12px 0">
          Find out more
        </mj-button>
      </mj-column>
    </mj-section>

    <!-- Footer dark background -->
    <mj-section background-color="#1B1932" padding="32px 48px 32px 48px">
      <mj-column>
        <mj-image src="https://placehold.co/80x20/1B1932/FFFFFF?text=racoon.ai" alt="racoon.ai" width="80px" padding="0 0 24px 0" />
      </mj-column>
    </mj-section>

    <!-- Footer nav -->
    <mj-section background-color="#1B1932" padding="0 48px 20px 48px">
      <mj-column width="20%">
        <mj-text color="#FFFFFF" font-size="14px" padding="0" align="center" font-weight="400">Home</mj-text>
      </mj-column>
      <mj-column width="20%">
        <mj-text color="#FFFFFF" font-size="14px" padding="0" align="center" font-weight="400">Product</mj-text>
      </mj-column>
      <mj-column width="20%">
        <mj-text color="#FFFFFF" font-size="14px" padding="0" align="center" font-weight="400">Solutions</mj-text>
      </mj-column>
      <mj-column width="20%">
        <mj-text color="#FFFFFF" font-size="14px" padding="0" align="center" font-weight="400">Help</mj-text>
      </mj-column>
      <mj-column width="20%">
        <mj-text color="#FFFFFF" font-size="14px" padding="0" align="center" font-weight="400">About</mj-text>
      </mj-column>
    </mj-section>

    <!-- App store buttons -->
    <mj-section background-color="#1B1932" padding="0 48px 32px 48px">
      <mj-column width="50%" vertical-align="middle">
        <mj-image src="https://placehold.co/134x40/000000/FFFFFF?text=Google+Play" alt="Google Play" width="134px" padding="0" />
      </mj-column>
      <mj-column width="50%" vertical-align="middle">
        <mj-image src="https://placehold.co/134x40/000000/FFFFFF?text=App+Store" alt="App Store" width="134px" padding="0" />
      </mj-column>
    </mj-section>

    <!-- Social icons -->
    <mj-section background-color="#1B1932" padding="0 48px 30px 48px">
      <mj-column width="25%">
        <mj-image src="https://placehold.co/24x24/303030/FFFFFF?text=F" alt="Facebook" width="24px" padding="0" />
      </mj-column>
      <mj-column width="25%">
        <mj-image src="https://placehold.co/24x24/303030/FFFFFF?text=X" alt="Twitter" width="24px" padding="0" />
      </mj-column>
      <mj-column width="25%">
        <mj-image src="https://placehold.co/24x24/303030/FFFFFF?text=IG" alt="Instagram" width="24px" padding="0" />
      </mj-column>
      <mj-column width="25%">
        <mj-image src="https://placehold.co/24x24/303030/FFFFFF?text=YT" alt="YouTube" width="24px" padding="0" />
      </mj-column>
    </mj-section>

    <!-- Unsubscribe link -->
    <mj-section background-color="#1B1932" padding="0 48px 24px 48px">
      <mj-column>
        <mj-text font-size="12px" color="#636363" align="center" padding="0">
          <a href="#" style="color:#636363; text-decoration:none;">Unsubscribe</a>
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
```
