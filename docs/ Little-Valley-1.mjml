    </mj-section>

    <mj-section background-color="#F6F1F9" padding="0 50px 30px 50px">
      <mj-column>
        <mj-text align="center" font-weight="700" font-size="18px" color="#1D1D1D" font-family="Arial, sans-serif" padding="0 0 10px 0">
          Hello <span style="color:#9782C6;">James!</span>
        </mj-text>
        <mj-text align="center" font-weight="400" font-size="13px" color="#3a3a3a" font-family="Arial, sans-serif" padding="0 0 0 0" line-height="20px">
