```mjml
<mjml>
  <mj-head>
    <mj-attributes>
      <mj-text font-family="Helvetica, Arial, sans-serif" line-height="1.4" />
      <mj-button font-family="Helvetica, Arial, sans-serif" font-weight="bold" border-radius="20px" />
    </mj-attributes>
  </mj-head>
  <mj-body width="600px" background-color="#ffe9ce">
    <!-- Header orange section -->
    <mj-section background-color="#f47e20" padding="30px 30px 40px 30px" border-radius="30px 30px 0 0">
      <mj-column>
        <mj-text color="#ffffff" font-size="20px" font-weight="bold" align="center" padding="0">
          transforme&nbsp;<span style="font-weight:300;">&#10006;</span>
        </mj-text>
        <mj-text color="#f4cece" font-size="12px" font-weight="300" font-style="italic" align="center" padding="9px 0 30px 0">
          Follow the powerful stories of change.
        </mj-text>
        <mj-image src="https://placehold.co/330x330?text=Sarah+Image" alt="Sarah" width="330px" border-radius="40px" padding="0" />
        <mj-text background-color="#f7b964" color="#000000" font-size="10px" font-weight="700" align="center" padding="20px 15px 5px 15px" border-radius="20px" mj-class="badge">
          TEXTILE ARTIST AT CUSH•ON
        </mj-text>
        <mj-text color="#ffffff" font-size="28px" font-weight="700" align="center" padding="0 0 10px 0">
          Meet Sarah
        </mj-text>
        <mj-text color="#ee3c00" font-size="18px" font-weight="600" align="center" padding="0 20px 20px 20px">
          Artist, Ocean breeze-lover, LA historian, Human Rights Unicorn
        </mj-text>
        <mj-text color="#f4cece" font-size="11px" font-weight="400" align="center" padding="0 45px 30px 45px" line-height="1.3">
          The prints you wear every day have been lovingly created by our resident Textile Print Designer, Sarah. Yes, that means the Unicorns you wear on your booty have been drawn by hand. Can you believe?! Sarah is an illustrator with 15 years of experience, and she’s been with TransformMe for over two years. Sarah absolutely loves creating for our customers, and her style is one of a kind.
        </mj-text>
        <mj-button href="#" background-color="#f47e20" color="#ffffff" padding="10px 35px" border-radius="20px">
          SHOP SARAH'S COLLECTION
        </mj-button>
      </mj-column>
    </mj-section>

    <!-- 3 styles section -->
    <mj-section background-color="#fff0de" padding="40px 30px 40px 30px" border-radius="0 0 30px 30px">
      <!-- Indonesian Styles -->
      <mj-column width="33%">
        <mj-image src="https://placehold.co/140x100?text=Indonesian+Style" alt="Indonesian Styles" padding="0 0 15px 0" />
        <mj-text color="#ee3c00" font-weight="600" font-size="16px" align="left" padding="0 0 7px 0">
          Indonesian Styles
        </mj-text>
        <mj-text color="#555555" font-size="12px" align="left" padding="0 0 15px 0" line-height="1.3">
          A traditional Indonesian textile art that creates unique patterns using a wax-resist dyeing technique.
        </mj-text>
        <mj-button href="#" background-color="#f47e20" color="#ffffff" padding="7px 10px" font-size="11px" border-radius="20px" inner-padding="6px 10px">
          EXPLORE DETAILS
        </mj-button>
      </mj-column>

      <!-- Contemporary -->
      <mj-column width="33%">
        <mj-image src="https://placehold.co/140x100?text=Contemporary" alt="Contemporary" padding="0 0 15px 0" />
        <mj-text color="#ee3c00" font-weight="600" font-size="16px" align="left" padding="0 0 7px 0">
          Contemporary
        </mj-text>
        <mj-text color="#555555" font-size="12px" align="left" padding="0 0 15px 0" line-height="1.3">
          Modern textile design combines old methods with new styles, using creative materials and technologies.
        </mj-text>
        <mj-button href="#" background-color="#f47e20" color="#ffffff" padding="7px 10px" font-size="11px" border-radius="20px" inner-padding="6px 10px">
          EXPLORE DETAILS
        </mj-button>
      </mj-column>

      <!-- Arabic Styles -->
      <mj-column width="33%">
        <mj-image src="https://placehold.co/140x100?text=Arabic+Style" alt="Arabic Styles" padding="0 0 15px 0" />
        <mj-text color="#ee3c00" font-weight="600" font-size="16px" align="left" padding="0 0 7px 0">
          Arabic Styles
        </mj-text>
        <mj-text color="#555555" font-size="12px" align="left" padding="0 0 15px 0" line-height="1.3">
          Arabic text lies are renowned for their intricate designs, vibrant colors, and luxurious materials.
        </mj-text>
        <mj-button href="#" background-color="#f47e20" color="#ffffff" padding="7px 10px" font-size="11px" border-radius="20px" inner-padding="6px 10px">
          EXPLORE DETAILS
        </mj-button>
      </mj-column>
    </mj-section>

    <!-- Her Creative Space section -->
    <mj-section background-color="#fef8f1" padding="50px 30px 50px 30px">
      <mj-column>
        <mj-image src="https://placehold.co/500x230?text=Her+Creative+Space" alt="Her Creative Space" border-radius="40px" padding="0 0 25px 0" />
        <mj-text color="#ee3c00" font-weight="600" font-size="20px" align="center" padding="0 0 10px 0">
          Her Creative Space
        </mj-text>
        <mj-text color="#555555" font-size="13px" font-weight="400" line-height="1.4" align="center" padding="0 45px 25px 45px">
          My desk energizes me. I can flow without pressure, listen to music, and create energy with the flow of the pencil.
        </mj-text>
        <mj-button href="#" background-color="#f47e20" color="#ffffff" padding="10px 35px" border-radius="30px">
          SHOP SARAH'S COLLECTION
        </mj-button>
      </mj-column>
    </mj-section>

    <!-- Stay Connected section -->
    <mj-section background-color="#ffe9ce" padding="20px 30px 0 30px">
      <mj-column>
        <mj-text font-size="18px" font-weight="600" color="#132935" align="center" padding="0 0 15px 0">
          Stay Connected
        </mj-text>
        <mj-social font-size="15px" icon-size="20px" mode="horizontal" align="center" padding="0 0 25px 0" color="#132935">
          <mj-social-element name="facebook" href="#" />
          <mj-social-element name="x" href="#" />
          <mj-social-element name="instagram" href="#" />
          <mj-social-element name="pinterest" href="#" />
        </mj-social>
        <mj-group>
          <mj-column>
            <mj-button href="#" background-color="transparent" color="#f47e20" font-weight="normal" padding="7px 20px" border-radius="20px" font-size="12px" css-class="footer-link" inner-padding="7px 10px" border="1px solid #f47e20">
              CONTACT
            </mj-button>
          </mj-column>
          <mj-column>
            <mj-button href="#" background-color="transparent" color="#f47e20" font-weight="normal" padding="7px 20px" border-radius="20px" font-size="12px" css-class="footer-link" inner-padding="7px 10px" border="1px solid #f47e20">
              LABS
            </mj-button>
          </mj-column>
        </mj-group>
        <mj-group>
          <mj-column>
