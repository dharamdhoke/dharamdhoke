          width="60px"
          padding="0"
        />
      </mj-column>
      <mj-column>
        <mj-text align="left" color="#4d080e" font-weight="700" font-family="Georgia, serif" font-size="16px" padding="0 0 8px 0" line-height="1.2">
          Driven by Curiosity
        </mj-text>
        <mj-text align="left" color="#4d080e" font-family="Georgia, serif" font-size="13.5px" line-height="1.4" padding="0">
          Good leaders give people the benefit of the doubt, they do not feel inclined to make negative assumptions about others. Instead, they like to learn more about the team.
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Item 5 -->
    <mj-section background-color="#60d1d8" padding="20px 30px">
      <mj-column width="120px">
        <mj-image 
          src="https://placehold.co/60x60?text=I5" 
          alt="Considers the Long-Term"
          width="60px"
          padding="0"
        />
      </mj-column>
      <mj-column>
        <mj-text align="left" color="#004445" font-weight="700" font-family="Georgia, serif" font-size="16px" padding="0 0 8px 0" line-height="1.2">
          Considers the Long-Term
        </mj-text>
        <mj-text align="left" color="#004445" font-family="Georgia, serif" font-size="13.5px" line-height="1.4" padding="0">
          Good leaders care about being productive today and getting things done before the end of the week. But they also care about the overall timescale, the impact of their present actions on the future.
        </mj-text>
      </mj-column>
    </mj-section>

