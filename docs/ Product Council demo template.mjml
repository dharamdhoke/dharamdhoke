        <mj-text align="center" color="#ffffff" font-weight="600" font-size="16px" font-family="Arial, sans-serif" padding="0">
          July 14–21, 2020
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Thoughts From The CEO -->
    <mj-section background-color="#f5f7f8" padding="20px 30px">
      <mj-column>
        <mj-text align="center" color="#333333" font-weight="700" font-size="18px" font-family="Arial, sans-serif" padding="0 0 15px 0">
          THOUGHTS FROM THE CEO
        </mj-text>
        <mj-section padding="0">
